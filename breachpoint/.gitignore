# Local-only content
Content/Developers/
Saved/Autosaves/

# Machine-local ladder config (testing.md: never committed)
Tools/env.local

# Crew scratch output. The crew re-derives these on every run; the LANDED copies
# live in Content/Data/ and are the only source of truth. Committing this folder
# would put a second, silently drifting DT_Weapons.csv next to the real one.
Tools/data-crew/output/

# Python tool caches
__pycache__/
*.pyc
build_editor_final.log

# Internal reference / dev-test assets — extracted game content, competitor art, uncleared
# packs. Local use is private; committing to a remote is distribution, which is the exposure
# worth preventing mechanically. Content/Reference is also in DirectoriesToNeverCook, so it
# cannot reach a packaged build. See Content/Reference/README.md.
Content/Reference/*
!Content/Reference/README.md

# Figma exports that failed pre-flight — diagnostic only, never shipped
Tools/gen_ui/quarantine/
