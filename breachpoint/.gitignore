# Unreal Engine generated directories
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Visual Studio / Rider
.vs/
.idea/
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# Local-only content
Content/Developers/
Saved/Autosaves/

# Machine-local ladder config (testing.md: never committed)
Tools/env.local

# Crew scratch output. The crew re-derives these on every run; the LANDED copies
# live in Content/Data/ and are the only source of truth. Committing this folder
# would put a second, silently drifting DT_Weapons.csv next to the real one.
Tools/data-crew/output/

# Python tool caches
__pycache__/
*.pyc
build_editor_final.log

# Internal reference / dev-test assets — extracted game content, competitor art, uncleared
# packs. Local use is private; committing to a remote is distribution, which is the exposure
# worth preventing mechanically. Content/Reference is also in DirectoriesToNeverCook, so it
# cannot reach a packaged build. See Content/Reference/README.md.
Content/Reference/*
!Content/Reference/README.md

# Figma exports that failed pre-flight — diagnostic only, never shipped
mcp-ui/gen_ui/quarantine/

# Figma SVG exports — vector source, staged for rasterising into Content/UI
# (tracked: these are original Breachpoint art + ISC-licensed Lucide)

# macOS Finder droppings inside Content/ - never assets.
.DS_Store

# Bulk local-only media. These are engine/marketplace source assets and rendered
# video, not authored Breachpoint work: 460MB that would eat the LFS quota and
# that anyone can re-add from the engine or the render pipeline. Kept local until
# a real asset-hosting story exists.
Content/Assets/LevelVisuals/
Content/Assets/Audio/
Content/Movies/

# Depends on Content/Assets/LevelVisuals above — would be a broken-reference map
# on a fresh clone. Lands when its dependencies do.
Content/Maps/FrontendTestMap.umap

# Build receipts: written by the gen_ui/audit tools, useful locally when a run dies
# mid-way, but 2.7 MB of logs in git is not history anyone reads.
docs/ui/receipts/

# BN35: extracted Halo 4 reference geometry - study material, never shipped.
Content/Halo4_Landfall/
Content/Halo3ODST_RallyPoint/
