# Repo-root attributes. Unreal source assets are governed by breachpoint/.gitattributes;
# this file governs the PACKAGED BUILD in Export/ (BN40's deliverable artifact).
#
# Debug symbols are deliberately NOT tracked -- see .gitignore. Breachpoint.pdb alone is
# 2.48 GB against a 1.05 GB game, it is regenerated by any rebuild, and no player needs it.

# Packaged build binaries -> Git LFS
*.exe   filter=lfs diff=lfs merge=lfs -text
*.dll   filter=lfs diff=lfs merge=lfs -text
*.ucas  filter=lfs diff=lfs merge=lfs -text
*.utoc  filter=lfs diff=lfs merge=lfs -text
*.pak   filter=lfs diff=lfs merge=lfs -text
*.ufont filter=lfs diff=lfs merge=lfs -text
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.bin   filter=lfs diff=lfs merge=lfs -text
*.so    filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
