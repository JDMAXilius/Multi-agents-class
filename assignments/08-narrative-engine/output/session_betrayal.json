{
 "session": "betrayal",
 "turns": [
  {
   "turn": 1,
   "action": "I search the gatekeeper's desk in the gatehouse for the vault key.",
   "deltas": [
    {
     "op": "add",
     "path": "player.inventory",
     "value": "vault_key"
    }
   ],
   "narration": "You wrench open the desk's swollen drawer and there it is, half-buried under mouse-chewed ledgers: a heavy iron key, cold to the touch. Sera leans over your shoulder, lantern light catching the vault sigil stamped into its head. 'That's it,' she says, already counting under her breath. 'One key, one climb, one Ember home before the snow. Don't lose it on the stair.'",
