  {
   "turn": 2,
   "action": "I tell Sera: 'I promise you \u2014 the Ember goes home to Harrow's Rest.' Then we take the stair down.",
   "deltas": [
    {
     "op": "set",
     "path": "player.location",
     "value": "stair_of_hooks"
